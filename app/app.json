{
  "expo": {
    "name": "Architect Loop",
    "slug": "architect-loop",
    "scheme": "architectloop",
    "version": "0.1.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EEF0EC",
    "ios": {
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.architectloop.architectloop"
    },
    "plugins": [
      [
        "expo-router",
        {
          "redirects": [
            {
              "source": "/index",
              "destination": "/inbox"
            }
          ]
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#2443B8"
        }
      ]
    ],
    "extra": {
      "router": {
        "redirects": [
          {
            "source": "/index",
            "destination": "/inbox"
          }
        ]
      },
      "eas": {
        "projectId": "f4679ac0-89a0-4067-8325-f4e6f5ea057c"
      }
    },
    "owner": "architect-loop"
  }
}
