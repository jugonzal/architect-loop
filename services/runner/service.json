{
  "identity": {"name": "runner", "roles": ["roles/run.jobsExecutorWithOverrides", "roles/datastore.user"]},
  "apis": ["firestore.googleapis.com"],
  "settings": {
    "RUNNER_GCP_PROJECT": "{project}",
    "RUNNER_STORE": "firestore:runner",
    "RUNNER_THREADS_URL": "https://threads-{number}.{region}.run.app",
    "RUNNER_APP_ID": {"staging": "5447264", "production": "TODO(owner)"},
    "RUNNER_APP_INSTALLATION_ID": {"staging": "174629085", "production": "TODO(owner)"},
    "RUNNER_APP_SLUG": {"staging": "architect-loop-runner", "production": "TODO(owner)"}
  },
  "secrets": {
    "RUNNER_APP_PRIVATE_KEY": "runner-app-private-key"
  },
  "firestore": ["runner"],
  "jobs": {
    "runner-session": {
      "command": ["python", "-m", "runner", "job"],
      "tasks": 1,
      "max_retries": 0,
      "task_timeout_s": 3600,
      "secrets": {
        "ANTHROPIC_API_KEY": "runner-anthropic-api-key"
      }
    }
  }
}
